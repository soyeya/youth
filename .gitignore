# ====== 보안: 환경변수 파일 (절대 커밋하지 말 것) ======
# 시크릿(API 키·DB 비밀번호·Gmail 앱 비밀번호)은 반드시 .env 에만 저장
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# .env.development / .env.production 은 PUBLIC_URL·API 주소만 담으므로 커밋 가능
# → 단, 이 파일에 절대 시크릿을 넣지 말 것

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# react-scripts build 산출물 (webpack build는 /docs 로 직접 출력)
/build

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
