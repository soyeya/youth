# GitHub Pages 배포 환경 설정 (npm run build / npm run deploy)
# react-scripts와 webpack 모두 이 파일을 참조

# GitHub Pages에서 백엔드가 없을 경우 비워두면 앱이 정책 조회 없이 빈 상태로 동작
# 백엔드를 별도 서버(Railway/Render 등)에 배포했다면 해당 URL 입력
REACT_APP_API_URL=https://youth-api.up.railway.app

# GitHub Pages 배포 경로 (package.json homepage와 일치시킬 것)
# react-scripts build는 homepage 값을 자동으로 PUBLIC_URL에 사용하므로 이 줄은
# webpack production build(npm run pre-build)를 위한 설정
PUBLIC_URL=/youth
