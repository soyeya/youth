# ============================================================
# .env.example — 새 환경 설정 시 이 파일을 복사해서 .env로 저장
# cp .env.example .env  →  .env 파일을 직접 수정하세요
# 이 파일은 GitHub에 커밋되는 예시 파일입니다 (실제 값 없음)
# ============================================================

# ─── 온통청년 포털 API 키 ──────────────────────────────────────
# 발급: https://www.youthcenter.go.kr (오픈API 신청)
YOUTH_API_KEY=your_youth_api_key_here
YOUTH_JOB_API_KEY=your_youth_job_api_key_here

# ─── 금융감독원 금융상품 비교공시 API 키 ───────────────────────
# 발급: https://finlife.fss.or.kr (오픈API 신청)
FINANCE_API_KEY=your_finance_api_key_here

# ─── 한국토지주택공사(LH) 공공데이터포털 API 키 ────────────────
# 발급: https://www.data.go.kr → '한국토지주택공사_임대공고정보조회서비스' 검색
LH_API_KEY=your_lh_api_key_here

# ─── MySQL DB 설정 ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=youth

# ─── Express 서버 포트 ─────────────────────────────────────────
PORT=3400

# ─── Gmail SMTP (이메일 인증코드 발송) ───────────────────────────
# ① 발신에 사용할 Gmail 주소
GMAIL_USER=your-email@gmail.com
# ② Gmail 앱 비밀번호 (16자리, 공백 없이)
#    발급: Google 계정 → 보안 → 2단계 인증 ON → 앱 비밀번호 생성
GMAIL_APP_PW=xxxx-xxxx-xxxx-xxxx

# ─── CORS 허용 오리진 (Railway 배포 시 추가) ─────────────────────
# 콤마로 구분, Railway 서버 URL을 배포 후 입력
# 예: ALLOWED_ORIGINS=https://your-app.up.railway.app
ALLOWED_ORIGINS=
